---
layout: default
---
<div class="post narrative-about">
  <header class="post-header narrative-about-hero">
    <div class="narrative-hero-copy">
      <p class="narrative-eyebrow">Researcher · Writer · Visual communicator</p>
      <h1 class="post-title">{{ site.first_name }}<br>{{ site.last_name }}</h1>
      <p class="desc">{{ page.subtitle }}</p>
    </div>
    {% if page.profile %}
      <div class="profile narrative-profile">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {%
            include figure.liquid loading="eager" path=profile_image_path class="img-fluid" sizes="(min-width: 768px) 42vw, 100vw" alt=page.profile.alt
            cache_bust=true
          %}
        {% endif %}
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}
      </div>
    {% endif %}
  </header>

  <article class="narrative-about-content">
    <div class="narrative-about-aside">
      <p class="narrative-eyebrow">About my work</p>
      <h2>Looking behind the systems that shape public understanding.</h2>
    </div>
    <div class="clearfix">{{ content }}</div>

    <!-- News -->
    {% if page.news and site.announcements.enabled %}
      <h2>
        <a href="{{ '/speaking-writing/' | relative_url }}" style="color: inherit">speaking &amp; writing</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if site.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2>
        <a href="{{ '/selected-work/' | relative_url }}" style="color: inherit">selected work</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% include social.liquid %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter.enabled and site.footer_fixed %}
      {% include scripts/newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
